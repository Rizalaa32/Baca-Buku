# ==============================================================================
# 1. AUTH.JS / NEXTAUTH & ACCESS CONTROL (SINGLE-USER WHITELIST)
# ==============================================================================
# URL aplikasi (gunakan http://localhost:3000 saat development, URL Vercel saat produksi)
NEXTAUTH_URL="http://localhost:3000"

# Generate secret acak minimal 32 karakter: `openssl rand -base64 32`
NEXTAUTH_SECRET="ganti-dengan-random-secret-minimal-32-karakter"

# Hanya alamat email Google ini yang diizinkan login dan mengakses API
ALLOWED_EMAIL="email.anda@gmail.com"

# ==============================================================================
# 2. GOOGLE CLOUD OAUTH 2.0 & GOOGLE DRIVE API V3
# ==============================================================================
# Buat OAuth 2.0 Client ID di Google Cloud Console (APIs & Services > Credentials)
# Aktifkan "Google Drive API" di Library Google Cloud Console.
# Tambahkan Authorized Redirect URI:
#   - http://localhost:3000/api/auth/callback/google
#   - https://domain-vercel-anda.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID="<masukkan-google-client-id-anda>"
GOOGLE_CLIENT_SECRET="<masukkan-google-client-secret-anda>"

# ID folder khusus koleksi buku di Google Drive Anda
# Contoh URL folder: https://drive.google.com/drive/folders/1aBcDeFgHiJkLmNoPqRsTuVwXyZ
# Maka GOOGLE_DRIVE_FOLDER_ID adalah: 1aBcDeFgHiJkLmNoPqRsTuVwXyZ
GOOGLE_DRIVE_FOLDER_ID="<masukkan-id-folder-google-drive-buku-anda>"

# ==============================================================================
# 3. SUPABASE (POSTGRESQL METADATA & CROSS-DEVICE SYNC)
# ==============================================================================
# Ambil dari Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref-anda>.supabase.co"

# Gunakan service_role key HANYA di sisi server (Next.js Route Handlers / Server Actions).
# RLS diaktifkan pada semua tabel sehingga endpoint publik tetap tertutup.
SUPABASE_SERVICE_ROLE_KEY="<masukkan-supabase-service-role-key-anda>"

# ==============================================================================
# 4. GEMINI AI READING BUDDY (@google/genai SDK)
# ==============================================================================
# Ambil API Key dari Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY="<masukkan-gemini-api-key-anda>"

# Catatan: Model gemini-1.5-flash & gemini-2.0-flash sudah deprecated.
# Gunakan model generasi terbaru yang direkomendasikan: gemini-3.8-flash
GEMINI_MODEL="gemini-3.8-flash"

